{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/check_stops.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/test.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/test",
      "dest": "/api/test"
    },
    {
      "src": "/api/check_stops",
      "dest": "/api/check_stops"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/check_stops",
      "schedule": "0 */4 * * *"
    }
  ]
}
